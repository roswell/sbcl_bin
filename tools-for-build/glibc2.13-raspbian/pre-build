# the published root.tar.xz is gone; carve the rootfs out of the full image instead
IMG=2015-05-05-raspbian-wheezy
curl -L -O https://downloads.raspberrypi.org/raspbian/images/raspbian-2015-05-07/$IMG.zip
unzip -o $IMG.zip
docker run --rm --privileged -v `pwd`:/w debian:12 \
  sh -c "mkdir -p /mnt/r; mount -o loop,offset=62914560,ro /w/$IMG.img /mnt/r; \
         tar -C /mnt/r -cf /w/root.tar .; umount /mnt/r"
rm -f $IMG.img $IMG.zip
docker image import ./root.tar raspbian_armhf:2015-05-12 --platform $DOCKER_PLATFORM
rm -f root.tar
docker images
